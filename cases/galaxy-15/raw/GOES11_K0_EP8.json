              },
              {
                "entryNum": 1,
                "cdfDatatype": "CDF_CHAR",
                "value": "Relevant metadata is carried over from the original data files to this newly created file. "
              },
              {
                "entryNum": 2,
                "cdfDatatype": "CDF_CHAR",
                "value": "Contacts: Tami.J.Kovalick@nasa.gov, Rita.C.Johnson@nasa.gov."
              },
              {
                "entryNum": 3,
                "cdfDatatype": "CDF_CHAR",
                "value": " "
              },
              {
                "entryNum": 4,
                "cdfDatatype": "CDF_CHAR",
                "value": "The NOAA Geostationary Operational"
              },
              {
                "entryNum": 5,
                "cdfDatatype": "CDF_CHAR",
                "value": "Environmental Satellite (GOES) key"
              },
              {
                "entryNum": 6,
                "cdfDatatype": "CDF_CHAR",
                "value": "parameters are obtained from the"
              },
              {
                "entryNum": 7,
                "cdfDatatype": "CDF_CHAR",
                "value": "Energetic Particle Sensor (EPS)"
              },
              {
                "entryNum": 8,
                "cdfDatatype": "CDF_CHAR",
                "value": "and the magnetometer (MAG).  The"
              },
              {
                "entryNum": 9,
                "cdfDatatype": "CDF_CHAR",
                "value": "key parameters are a subset of the"
              },
              {
                "entryNum": 10,
                "cdfDatatype": "CDF_CHAR",
                "value": "data available from the GOES Space"
              },
              {
                "entryNum": 11,
                "cdfDatatype": "CDF_CHAR",
                "value": "Environment Monitor (SEM) instruments."
              },
              {
                "entryNum": 12,
                "cdfDatatype": "CDF_CHAR",
                "value": "The energetic particle fluxes are"
              },
              {
                "entryNum": 13,
                "cdfDatatype": "CDF_CHAR",
                "value": "given as five-minute averaged values"
              },
              {
                "entryNum": 14,
                "cdfDatatype": "CDF_CHAR",
                "value": "and the vector magnetic field is given"
              },
              {
                "entryNum": 15,
                "cdfDatatype": "CDF_CHAR",
                "value": "as one-minute average values."
              },
              {
                "entryNum": 16,
                "cdfDatatype": "CDF_CHAR",
                "value": "Flux values for three integral electron"
              },
              {
                "entryNum": 17,
                "cdfDatatype": "CDF_CHAR",
                "value": "channels (E >0.6 MeV, E >2.0 MeV,"
              },
              {
                "entryNum": 18,
                "cdfDatatype": "CDF_CHAR",
                "value": "and E >4.0 MeV) and one differential"
              },
              {
                "entryNum": 19,
                "cdfDatatype": "CDF_CHAR",
                "value": "proton channel(0.7 MeV < E <4 MeV)"
              },
              {
                "entryNum": 20,
                "cdfDatatype": "CDF_CHAR",
                "value": "are provided. These data are used by"
              },
              {
                "entryNum": 21,
                "cdfDatatype": "CDF_CHAR",
                "value": "NOAA Space Environment Center (SEC)"
              },
              {
                "entryNum": 22,
                "cdfDatatype": "CDF_CHAR",
                "value": "for the real-time monitoring and"
              },
              {
                "entryNum": 23,
                "cdfDatatype": "CDF_CHAR",
                "value": "prediction of the conditions in the"
              },
              {
                "entryNum": 24,
                "cdfDatatype": "CDF_CHAR",
                "value": "Earth's space environment.  A new"
              },
              {
                "entryNum": 25,
                "cdfDatatype": "CDF_CHAR",
                "value": "series of GOES spacecraft began"
              },
              {
                "entryNum": 26,
                "cdfDatatype": "CDF_CHAR",
                "value": "with GOES-8 launched on 4/13/94,"
              },
              {
                "entryNum": 27,
                "cdfDatatype": "CDF_CHAR",
                "value": "GOES-9 launched on 5/23/95,"
              },
              {
                "entryNum": 28,
                "cdfDatatype": "CDF_CHAR",
                "value": "GOES-10 launched on 4/25/97,"
              },
              {
                "entryNum": 29,
                "cdfDatatype": "CDF_CHAR",
                "value": "GOES-11 launched on 5/3/2000, and"
              },
              {
                "entryNum": 30,
                "cdfDatatype": "CDF_CHAR",
                "value": "GOES-12 launched on 7/23/2001."
              },
              {
                "entryNum": 31,
                "cdfDatatype": "CDF_CHAR",
                "value": "Typically two satellites are maintained"
              },
              {
                "entryNum": 32,
                "cdfDatatype": "CDF_CHAR",
                "value": "operational,one at about 135 degrees"
              },
              {
                "entryNum": 33,
                "cdfDatatype": "CDF_CHAR",
                "value": "geographic west longitude and one at"
              },
              {
                "entryNum": 34,
                "cdfDatatype": "CDF_CHAR",
                "value": "about 75 degrees geographic west"
              },
              {
                "entryNum": 35,
                "cdfDatatype": "CDF_CHAR",
                "value": "longitude. The satellite inclination"
              },
              {
                "entryNum": 36,
                "cdfDatatype": "CDF_CHAR",
                "value": "is typically within a few tenths of a"
              },
              {
                "entryNum": 37,
                "cdfDatatype": "CDF_CHAR",
                "value": "degree of the geographic equator."
              },
              {
                "entryNum": 38,
                "cdfDatatype": "CDF_CHAR",
                "value": "However, the satellites can be moved,"
              },
              {
                "entryNum": 39,
                "cdfDatatype": "CDF_CHAR",
                "value": "especially during the six months to"
              },
              {
                "entryNum": 40,
                "cdfDatatype": "CDF_CHAR",
                "value": "one year following launch, and the"
              },
              {
                "entryNum": 41,
                "cdfDatatype": "CDF_CHAR",
                "value": "inclination can increase after years"
              },
              {
                "entryNum": 42,
                "cdfDatatype": "CDF_CHAR",
                "value": "of satellite operation."
              },
              {
                "entryNum": 43,
                "cdfDatatype": "CDF_CHAR",
                "value": "Instrument data quality flags are set"
              },
              {
                "entryNum": 44,
                "cdfDatatype": "CDF_CHAR",
                "value": "from real-time telemetry, or, in"
              },
              {
                "entryNum": 45,
                "cdfDatatype": "CDF_CHAR",
                "value": "the case of historically-processed"
              },
              {
                "entryNum": 46,
                "cdfDatatype": "CDF_CHAR",
                "value": "data sets when telemetry is not"
              },
              {
                "entryNum": 47,
                "cdfDatatype": "CDF_CHAR",
                "value": "available, fixed to a level-1"
              },
              {
                "entryNum": 48,
