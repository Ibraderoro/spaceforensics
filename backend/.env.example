# SPACEFORENSICS — backend environment variables
# Copy this file to .env and fill in the values.

# Server
PORT=5001

# ── CORS (Phase 9.9 — production security) ───────────────────────────────────
#
# Comma-separated list of allowed frontend origins.
# In development the default covers the Vite dev server and preview server:
#   http://localhost:5173,http://localhost:4173
# In production set this to the actual frontend origin, e.g.:
#   ALLOWED_ORIGINS=https://spaceforensics.example.com
#
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# IBM Watsonx.ai credentials (Phase 3 — AI Engine)
# Obtain from https://cloud.ibm.com/iam/apikeys and https://dataplatform.cloud.ibm.com
WATSONX_AI_APIKEY=
WATSONX_AI_PROJECT_ID=
WATSONX_AI_URL=https://us-south.ml.cloud.ibm.com

# ── PostgreSQL investigation persistence (Phase 8.2 / 8.7) ──────────────────
#
# When PG_DATABASE is set, investigations are persisted to a PostgreSQL
# database and all store operations become async (awaited throughout server.js).
# When PG_DATABASE is unset, the in-memory repository is used automatically
# (suitable for tests and local development without PostgreSQL).
#
# Operational requirements:
#   • PostgreSQL 13+ recommended (uses JSONB columns and standard ISO timestamps)
#   • The application user must have CREATE TABLE / ALTER TABLE / SELECT /
#     INSERT / UPDATE / DELETE on the target database/schema
#   • Run migrations on first start — the server calls runMigrations(pool)
#     automatically when PG_DATABASE is set (see backend/db/migrate.js)
#   • For high-availability deployments set PG_MAX_CLIENTS to match the
#     expected concurrent request load (default 10 is suitable for development)
#   • SSL is recommended in production: set PG_SSL=true and ensure the server
#     certificate is trusted by the Node process (NODE_EXTRA_CA_CERTS or system
#     trust store)
#
# Connection parameters:
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
# PG_SSL=false         # set to true for TLS-encrypted connections
# PG_MAX_CLIENTS=10    # connection pool size (increase for high load)

# ── Error mapping for PostgreSQL failures (no configuration needed) ───────────
#
# The server maps PostgreSQL error codes to safe HTTP responses automatically:
#   08xxx (connection failure)      → 503 Service Unavailable
#   40001 / 40P01 (serialisation)   → 503 Service Unavailable (retry)
#   23505 (unique violation)        → 409 Conflict
#   23503 (FK violation)            → 422 Unprocessable Entity
#   all other DB errors             → 500 Internal Server Error
#
# In all cases only the error_code and a safe message are returned to the
# client — no SQL text, stack traces, connection strings, or credentials are
# ever included in the HTTP response body.
